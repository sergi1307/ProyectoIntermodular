  "id_delivery_point": 1,
  "id_category": 1,
  "name": "Manzanas Golden",
  "description": "Frescas y crujientes",
  "price": 2.5,
  "stock": 50,
  "type_stock": "Kg",
  "state": "Disponible"
}

### Actualizar producto (id=1) (Usuario 1)
PUT http://localhost:8080/api/products/update/1
Authorization: Bearer 3|lUpZD7AsbH99zw7msZihUQq7MED9nHuBLI5Z7XrR60739cdd
Content-Type: application/json
Accept: application/json

{
  "price": 2.8,
  "stock": 45
}

